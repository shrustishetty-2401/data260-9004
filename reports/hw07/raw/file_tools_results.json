{
  "integration_test": {
    "glob": {
      "ok": true,
      "matches": [
        "alpha.py",
        "beta.py",
        "gamma.py"
      ]
    },
    "search": {
      "ok": true,
      "query": "DEBUG",
      "matches": [
        "beta.py"
      ]
    },
    "read": {
      "ok": true,
      "path": "beta.py",
      "content": "DEBUG = True\nprint(\"beta\")"
    }
  },
  "safety_gate_test": [
    {
      "command": "pwd",
      "expected_allowed": true,
      "actual_allowed": true,
      "passed": true
    },
    {
      "command": "ls",
      "expected_allowed": true,
      "actual_allowed": true,
      "passed": true
    },
    {
      "command": "echo hello",
      "expected_allowed": true,
      "actual_allowed": true,
      "passed": true
    },
    {
      "command": "printf test",
      "expected_allowed": true,
      "actual_allowed": true,
      "passed": true
    },
    {
      "command": "grep DEBUG beta.py",
      "expected_allowed": true,
      "actual_allowed": true,
      "passed": true
    },
    {
      "command": "rm -rf .",
      "expected_allowed": false,
      "actual_allowed": false,
      "passed": true
    },
    {
      "command": "sudo ls",
      "expected_allowed": false,
      "actual_allowed": false,
      "passed": true
    },
    {
      "command": "chmod 777 beta.py",
      "expected_allowed": false,
      "actual_allowed": false,
      "passed": true
    },
    {
      "command": "dd if=/dev/zero of=/dev/disk1",
      "expected_allowed": false,
      "actual_allowed": false,
      "passed": true
    },
    {
      "command": "echo secret > /etc/hosts",
      "expected_allowed": false,
      "actual_allowed": false,
      "passed": true
    }
  ],
  "safety_passed": 10,
  "safety_total": 10,
  "write_without_confirmation": {
    "ok": false,
    "error": "Write blocked without confirmation."
  },
  "path_traversal": {
    "blocked": true,
    "reason": "Blocked: path is outside the approved sandbox."
  }
}